[
  {
    "name": "HeroBanner",
    "schema": {
      "title": "Hero Banner",
      "description": "Grande image pleine largeur avec titre, sous-titre et bouton CTA en overlay",
      "type": "object",
      "properties": {
        "image": {
          "title": "Image (desktop)",
          "type": "string",
          "default": ""
        },
        "imageAlt": {
          "title": "Description de l'image (alt)",
          "type": "string",
          "default": ""
        },
        "imageMobile": {
          "title": "Image mobile (optionnel)",
          "description": "Si vide, l'image desktop est utilisée sur mobile",
          "type": "string",
          "default": ""
        },
        "title": {
          "title": "Titre",
          "type": "string",
          "default": ""
        },
        "subtitle": {
          "title": "Sous-titre (optionnel)",
          "type": "string",
          "default": ""
        },
        "linkUrl": {
          "title": "URL du lien (optionnel)",
          "type": "string",
          "default": ""
        },
        "linkLabel": {
          "title": "Texte du bouton CTA (optionnel)",
          "type": "string",
          "default": "Découvrir"
        },
        "textPosition": {
          "title": "Position du texte",
          "type": "string",
          "enumNames": [
            "Haut gauche", "Haut centre", "Haut droite",
            "Centre gauche", "Centre", "Centre droite",
            "Bas gauche", "Bas centre", "Bas droite"
          ],
          "enum": [
            "top-left", "top-center", "top-right",
            "center-left", "center-center", "center-right",
            "bottom-left", "bottom-center", "bottom-right"
          ],
          "default": "bottom-left"
        },
        "textColor": {
          "title": "Couleur du texte",
          "type": "string",
          "enumNames": ["Blanc", "Noir"],
          "enum": ["white", "black"],
          "default": "white"
        },
        "overlayOpacity": {
          "title": "Opacité de l'overlay sombre (0-100)",
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  },
  {
    "name": "LookbookGrid",
    "schema": {
      "title": "Lookbook Grid",
      "description": "3 cellules éditoriales côte à côte avec image, titre et lien",
      "type": "object",
      "required": ["cell1", "cell2", "cell3"],
      "properties": {
        "textPosition": {
          "title": "Position du texte",
          "type": "string",
          "enumNames": [
            "Haut gauche", "Haut centre", "Haut droite",
            "Centre gauche", "Centre", "Centre droite",
            "Bas gauche", "Bas centre", "Bas droite"
          ],
          "enum": [
            "top-left", "top-center", "top-right",
            "center-left", "center-center", "center-right",
            "bottom-left", "bottom-center", "bottom-right"
          ],
          "default": "center-center"
        },
        "textColor": {
          "title": "Couleur du texte",
          "type": "string",
          "enumNames": ["Blanc", "Noir"],
          "enum": ["white", "black"],
          "default": "white"
        },
        "cell1": {
          "title": "Cellule 1",
          "type": "object",
          "required": ["image", "imageAlt", "title", "linkUrl", "linkLabel"],
          "properties": {
            "image": {
              "title": "URL de l'image",
              "type": "string",
              "default": "https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=800&h=1067&fit=crop"
            },
            "imageAlt": {
              "title": "Description de l'image (alt)",
              "type": "string",
              "default": "Nouvelle Collection Femme"
            },
            "title": {
              "title": "Titre",
              "type": "string",
              "default": "Nouvelle Collection"
            },
            "subtitle": {
              "title": "Sous-titre (optionnel)",
              "type": "string",
              "default": "Printemps — Été 2025"
            },
            "linkUrl": {
              "title": "URL du lien",
              "type": "string",
              "default": "/outillage"
            },
            "linkLabel": {
              "title": "Texte du bouton CTA",
              "type": "string",
              "default": "Découvrir"
            }
          }
        },
        "cell2": {
          "title": "Cellule 2",
          "type": "object",
          "required": ["image", "imageAlt", "title", "linkUrl", "linkLabel"],
          "properties": {
            "image": {
              "title": "URL de l'image",
              "type": "string",
              "default": "https://images.unsplash.com/photo-1558769132-cb1aea458c5e?w=800&h=1067&fit=crop"
            },
            "imageAlt": {
              "title": "Description de l'image (alt)",
              "type": "string",
              "default": "Tendances Hiver"
            },
            "title": {
              "title": "Titre",
              "type": "string",
              "default": "Tendances Hiver"
            },
            "subtitle": {
              "title": "Sous-titre (optionnel)",
              "type": "string",
              "default": "Sélection éditoriale"
            },
            "linkUrl": {
              "title": "URL du lien",
              "type": "string",
              "default": "/outillage"
            },
            "linkLabel": {
              "title": "Texte du bouton CTA",
              "type": "string",
              "default": "Explorer"
            }
          }
        },
        "cell3": {
          "title": "Cellule 3",
          "type": "object",
          "required": ["image", "imageAlt", "title", "linkUrl", "linkLabel"],
          "properties": {
            "image": {
              "title": "URL de l'image",
              "type": "string",
              "default": "https://images.unsplash.com/photo-1469334031218-e382a71b716b?w=800&h=1067&fit=crop"
            },
            "imageAlt": {
              "title": "Description de l'image (alt)",
              "type": "string",
              "default": "Nouveautés"
            },
            "title": {
              "title": "Titre",
              "type": "string",
              "default": "Nouveautés"
            },
            "subtitle": {
              "title": "Sous-titre (optionnel)",
              "type": "string"
            },
            "linkUrl": {
              "title": "URL du lien",
              "type": "string",
              "default": "/outillage"
            },
            "linkLabel": {
              "title": "Texte du bouton CTA",
              "type": "string",
              "default": "Voir tout"
            }
          }
        }
      }
    }
  },
  {
    "name": "FullWidthShelf",
    "schema": {
      "title": "Full Width Shelf",
      "description": "Carousel produits pleine largeur avec swap d'image au hover",
      "type": "object",
      "properties": {
        "title": {
          "title": "Titre de la section (optionnel)",
          "type": "string",
          "default": ""
        },
        "categorySlug": {
          "title": "Nom de catégorie",
          "description": "Nom exact de la catégorie dans VTEX Admin (ex: Clothes, Accessories, Bags). Insensible à la casse.",
          "type": "string",
          "default": ""
        },
        "count": {
          "title": "Nombre de produits à afficher",
          "type": "number",
          "default": 8,
          "enum": [4, 8, 12],
          "enumNames": ["4 produits", "8 produits", "12 produits"]
        }
      }
    }
  },
